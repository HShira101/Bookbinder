{
  "palette": {
    "ink": "#26282b",
    "inkSoft": "#646a70",
    "accent": "#34506b",
    "accentSoft": "#7d93a8",
    "metal": "#8b8f94",
    "paper": "#f4f1e8",
    "cover": "#33302c"
  },
  "surfaces": {
    "background": {
      "color": "#0c0b0a",
      "highlight": "#33302c"
    },
    "cover": {
      "color": "$cover",
      "texture": "none",
      "width": 22,
      "radius": 0,
      "shadow": "none"
    },
    "paper": {
      "color": "$paper",
      "noise": 0.25,
      "vignette": 0.05,
      "frame": {
        "enabled": false
      }
    },
    "spine": {
      "shadow": 0,
      "width": 0
    }
  },
  "typography": {
    "base": {
      "font": "Amiri",
      "fallback": "Signika",
      "size": 15,
      "lineHeight": 1.5,
      "color": "$ink",
      "generic": "serif"
    }
  },
  "elements": {
    "h1": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 31,
      "weight": 700,
      "color": "$ink",
      "align": "center",
      "lineHeight": 1.15,
      "generic": "sans-serif"
    },
    "h2": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 20,
      "weight": 700,
      "color": "$accent",
      "borderBottom": {
        "width": 2,
        "color": "$accent"
      },
      "marginBottom": 8,
      "generic": "sans-serif"
    },
    "h3": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 16.5,
      "weight": 700,
      "color": "$ink",
      "generic": "sans-serif"
    },
    "h4": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 13.5,
      "weight": 700,
      "transform": "uppercase",
      "letterSpacing": 0.08,
      "color": "$accent",
      "generic": "sans-serif"
    },
    "h5": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 11.5,
      "weight": 600,
      "transform": "uppercase",
      "letterSpacing": 0.14,
      "color": "$inkSoft",
      "generic": "sans-serif"
    },
    "h6": {
      "size": 14,
      "weight": 400,
      "style": "italic",
      "color": "$inkSoft"
    },
    "strong": {
      "weight": 600
    },
    "em": {
      "style": "italic"
    },
    "u": {
      "underline": "solid"
    },
    "s": {
      "color": "$inkSoft"
    },
    "a": {
      "color": "$accent",
      "underline": "solid"
    },
    "code": {
      "font": "Courier New",
      "fallback": "Signika",
      "size": 13,
      "background": "rgba(52,80,107,.1)",
      "color": "$accent",
      "generic": "monospace"
    },
    "blockquote": {
      "style": "italic",
      "color": "$inkSoft",
      "borderLeft": {
        "width": 3,
        "color": "$accentSoft"
      }
    },
    "cite": {
      "color": "$accent"
    },
    "ul": {
      "bullet": "•",
      "bulletColor": "$accent"
    },
    "ol": {
      "numbering": "decimal",
      "bulletColor": "$accent"
    },
    "hr": {
      "type": "line",
      "color": "rgba(38,40,43,.25)"
    },
    "table": {
      "header": {
        "font": "Signika",
        "fallback": "Signika",
        "size": 12,
        "weight": 700,
        "transform": "uppercase",
        "letterSpacing": 0.06,
        "color": "$ink",
        "borderBottom": {
          "width": 1.5,
          "color": "$ink"
        },
        "generic": "sans-serif"
      },
      "cell": {
        "borderBottom": {
          "width": 1,
          "color": "rgba(38,40,43,.15)"
        }
      },
      "stripedRows": "rgba(38,40,43,.035)"
    },
    "contentLink": {
      "color": "$accent",
      "background": "rgba(52,80,107,.08)",
      "border": {
        "width": 1,
        "color": "rgba(52,80,107,.35)"
      },
      "radius": 4
    },
    "inlineRoll": {
      "color": "#7a3b1e",
      "background": "rgba(181,83,47,.1)",
      "border": {
        "width": 1,
        "color": "rgba(181,83,47,.4)"
      },
      "radius": 4
    },
    "secret": {
      "color": "$inkSoft",
      "background": "rgba(38,40,43,.05)",
      "border": {
        "width": 1,
        "color": "$inkSoft",
        "style": "dashed"
      }
    },
    "img": {
      "border": {
        "width": 1,
        "color": "rgba(38,40,43,.35)"
      },
      "shadow": "soft"
    },
    "figcaption": {
      "size": 12.5,
      "color": "$inkSoft"
    },
    "dropCap": {
      "enabled": false
    }
  },
  "ornaments": {
    "watermark": {
      "type": "none"
    },
    "corners": {
      "style": "none"
    },
    "folio": {
      "format": "{n}",
      "color": "$inkSoft",
      "font": "Signika",
      "fallback": "Signika",
      "size": 11.5,
      "generic": "sans-serif"
    }
  },
