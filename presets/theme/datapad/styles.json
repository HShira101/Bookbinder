{
  "palette": {
    "ink": "#c7ecfa",
    "inkSoft": "#7fb3c8",
    "accent": "#4fd8ff",
    "accentSoft": "#1f7fa3",
    "metal": "#39404d",
    "paper": "#071624",
    "cover": "#252a34",
    "glow": "rgba(79,216,255,.28)"
  },
  "surfaces": {
    "background": {
      "color": "#04070b",
      "highlight": "#101a26"
    },
    "cover": {
      "color": "$cover",
      "image": "cover",
      "texture": "metal",
      "width": 20,
      "radius": 20,
      "shadow": "strong"
    },
    "paper": {
      "color": "$paper",
      "noise": 0.12,
      "vignette": 0.7,
      "vignetteColor": "#000814",
      "pattern": {
        "type": "scanlines",
        "color": "rgba(120,220,255,.055)",
        "size": 3
      },
      "frame": {
        "enabled": true,
        "style": "brackets",
        "color": "$accent",
        "inset": 10,
        "width": 2
      }
    },
    "spine": {
      "shadow": 0,
      "width": 0
    }
  },
  "typography": {
    "base": {
      "font": "Signika",
      "fallback": "Signika",
      "size": 14,
      "lineHeight": 1.5,
      "color": "$ink",
      "generic": "sans-serif"
    }
  },
  "elements": {
    "h1": {
      "font": "Bruno Ace",
      "size": 25,
      "weight": 400,
      "color": "$accent",
      "align": "center",
      "transform": "uppercase",
      "letterSpacing": 0.04,
      "shadow": "glow",
      "lineHeight": 1.3
    },
    "h2": {
      "font": "Bruno Ace",
      "size": 16,
      "weight": 400,
      "color": "$accent",
      "transform": "uppercase",
      "letterSpacing": 0.06,
      "borderBottom": {
        "width": 1,
        "color": "$accentSoft"
      },
      "marginBottom": 9
    },
    "h3": {
      "size": 15,
      "weight": 600,
      "color": "#8ff0c8",
      "transform": "uppercase",
      "letterSpacing": 0.1
    },
    "h4": {
      "size": 15,
      "weight": 600,
      "color": "$ink"
    },
    "h5": {
      "font": "Courier New",
      "size": 12,
      "weight": 400,
      "color": "$accent",
      "transform": "uppercase",
      "letterSpacing": 0.14
    },
    "h6": {
      "size": 13,
      "weight": 400,
      "style": "italic",
      "color": "$inkSoft"
    },
    "strong": {
      "weight": 600,
      "color": "#ffffff"
    },
    "em": {
      "style": "italic",
      "color": "#a8f0ff"
    },
    "u": {
      "underline": "dotted"
    },
    "s": {
      "color": "$inkSoft"
    },
    "a": {
      "color": "$accent",
      "underline": "solid"
    },
    "code": {
      "font": "Courier New",
      "fallback": "Signika",
      "size": 13,
      "background": "rgba(79,216,255,.1)",
      "color": "#8ff0c8",
      "generic": "monospace"
    },
    "blockquote": {
      "color": "#b5dfee",
      "background": "rgba(79,216,255,.07)",
      "borderLeft": {
        "width": 3,
        "color": "$accent"
      },
      "padding": [
        8,
        12
      ]
    },
    "cite": {
      "font": "Courier New",
      "size": 11.5,
      "color": "$accent"
    },
    "ul": {
      "bullet": "▸",
      "bulletColor": "$accent"
    },
    "ol": {
      "numbering": "decimal",
      "bulletColor": "$accent"
    },
    "hr": {
      "type": "fade",
      "color": "$accent",
      "width": 1
    },
    "table": {
      "header": {
        "font": "Courier New",
        "size": 11.5,
        "weight": 400,
        "transform": "uppercase",
        "letterSpacing": 0.08,
        "color": "$accent",
        "background": "rgba(79,216,255,.16)"
      },
      "cell": {
        "borderBottom": {
          "width": 1,
          "color": "rgba(79,216,255,.2)"
        }
      },
      "stripedRows": "rgba(79,216,255,.05)"
    },
    "contentLink": {
      "color": "$accent",
      "background": "rgba(79,216,255,.08)",
      "border": {
        "width": 1,
        "color": "$accentSoft"
      },
      "radius": 2
    },
    "inlineRoll": {
      "font": "Courier New",
      "color": "#ffcf70",
      "background": "rgba(255,179,71,.1)",
      "border": {
        "width": 1,
        "color": "#b37a2a"
      },
      "radius": 2
    },
    "secret": {
      "color": "#ffb3ab",
      "background": "rgba(255,90,77,.08)",
      "border": {
        "width": 1,
        "color": "#ff5a4d",
        "style": "dashed"
      }
    },
    "img": {
      "border": {
        "width": 1,
        "color": "$accentSoft"
      },
      "shadow": "glow"
    },
    "figcaption": {
      "font": "Courier New",
      "size": 11,
      "color": "$inkSoft",
      "style": "normal"
    },
    "dropCap": {
      "enabled": false
    }
  },
  "ornaments": {
    "watermark": {
      "type": "image",
      "resource": "logo",
      "size": 46,
      "opacity": 0.05
    },
    "header": {
      "enabled": true,
      "color": "$accentSoft",
      "font": "Courier New",
      "fallback": "Signika",
      "generic": "monospace"
    },
    "folio": {
      "format": "[ {n} ]",
      "color": "$accentSoft",
      "font": "Courier New",
      "fallback": "Signika",
      "letterSpacing": 0.2,
      "generic": "monospace"
    },
    "corners": {
      "style": "none"
    }
  },
  "sheets": {
    "classified": {
      "name": "Classified Report",
      "paper": {
        "color": "#150a0c",
        "vignetteColor": "#120000",
        "pattern": {
          "type": "scanlines",
          "color": "rgba(255,120,110,.06)",
          "size": 3
        },
        "frame": {
          "enabled": true,
          "style": "brackets",
          "color": "#ff5a4d",
          "inset": 10,
          "width": 2
        }
      },
      "typography": {
        "base": {
          "color": "#f3d2cd"
        }
      },
      "elements": {
        "h1": {
          "color": "#ff5a4d"
        },
        "h2": {
          "color": "#ff5a4d",
          "borderBottom": {
            "width": 1,
            "color": "#8a2a24"
          }
        },
        "h3": {
          "color": "#ffb347"
        },
        "h5": {
          "color": "#ff5a4d"
        },
        "strong": {
          "color": "#fff"
        },
        "em": {
          "color": "#ffc9c2"
        },
        "s": {
          "color": "#f3d2cd",
          "background": "#f3d2cd"
        },
        "a": {
          "color": "#ff8a7f"
        },
        "code": {
          "background": "rgba(255,90,77,.12)",
          "color": "#ffb347"
        },
        "blockquote": {
          "color": "#f0c4be",
          "background": "rgba(255,90,77,.08)",
          "borderLeft": {
            "width": 3,
            "color": "#ff5a4d"
          }
        },
        "cite": {
          "color": "#ff5a4d"
        },
        "hr": {
          "color": "#ff5a4d"
        },
        "ul": {
          "bulletColor": "#ff5a4d"
        },
        "ol": {
          "bulletColor": "#ff5a4d"
        },
        "table": {
          "header": {
            "color": "#ff8a7f",
            "background": "rgba(255,90,77,.18)"
          },
          "cell": {
            "borderBottom": {
              "width": 1,
              "color": "rgba(255,90,77,.24)"
            }
          },
          "stripedRows": "rgba(255,90,77,.05)"
        },
        "contentLink": {
          "color": "#ff8a7f",
          "background": "rgba(255,90,77,.08)",
          "border": {
            "width": 1,
            "color": "#8a2a24"
          }
        },
        "img": {
          "border": {
            "width": 1,
            "color": "#8a2a24"
          },
          "shadow": "none"
        }
      },
      "ornaments": {
        "watermark": {
          "type": "text",
          "text": "CLASIFICADO",
          "font": "Bruno Ace",
          "size": 46,
          "color": "#ff5a4d",
          "opacity": 0.1,
          "tilt": -32
        },
        "header": {
          "color": "#a8372f"
        },
        "folio": {
          "color": "#a8372f"
        },
        "stamp": {
          "text": "NIVEL 5",
          "font": "Courier New",
          "size": 12,
          "color": "#ff5a4d",
          "position": "bottom right",
          "offsetX": 24,
          "offsetY": 30,
          "opacity": 0.9
        }
      }
    },
    "alert": {
      "name": "Alert",
      "paper": {
        "color": "#1f1503",
        "vignetteColor": "#0a0600",
        "pattern": {
          "type": "scanlines",
          "color": "rgba(255,200,90,.07)",
          "size": 3
        },
        "frame": {
          "enabled": true,
          "style": "brackets",
          "color": "#ffb347",
          "inset": 10,
          "width": 2
        }
      },
      "typography": {
        "base": {
          "color": "#ffe2ad"
        }
      },
      "elements": {
        "h1": {
          "color": "#ffb347"
        },
        "h2": {
          "color": "#ffb347",
          "borderBottom": {
            "width": 1,
            "color": "#8a5a14"
          }
        },
        "h3": {
          "color": "#ffd98a"
        },
        "h5": {
          "color": "#ffb347"
        },
        "strong": {
          "color": "#fff"
        },
        "em": {
          "color": "#fff0cf"
        },
        "a": {
          "color": "#ffcf70"
        },
        "code": {
          "background": "rgba(255,179,71,.12)",
          "color": "#ffd98a"
        },
        "blockquote": {
          "color": "#ffe2ad",
          "background": "rgba(255,179,71,.09)",
          "borderLeft": {
            "width": 3,
            "color": "#ffb347"
          }
        },
        "cite": {
          "color": "#ffb347"
        },
        "hr": {
          "color": "#ffb347"
        },
        "ul": {
          "bulletColor": "#ffb347"
        },
        "ol": {
          "bulletColor": "#ffb347"
        },
        "table": {
          "header": {
            "color": "#ffcf70",
            "background": "rgba(255,179,71,.18)"
          },
          "cell": {
            "borderBottom": {
              "width": 1,
              "color": "rgba(255,179,71,.26)"
            }
          },
          "stripedRows": "rgba(255,179,71,.06)"
        },
        "contentLink": {
          "color": "#ffcf70",
          "background": "rgba(255,179,71,.08)",
          "border": {
            "width": 1,
            "color": "#8a5a14"
          }
        },
        "img": {
          "border": {
            "width": 1,
            "color": "#8a5a14"
          },
          "shadow": "none"
        }
      },
      "ornaments": {
        "watermark": {
          "type": "text",
          "text": "⚠",
          "font": "Amiri",
          "size": 280,
          "color": "#ffb347",
          "opacity": 0.07
        },
        "header": {
          "color": "#a87320"
        },
        "folio": {
          "color": "#a87320"
        }
      }
    }
  }
}
