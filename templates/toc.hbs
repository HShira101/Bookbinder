<aside class="bookbinder-toc{{#if collapsed}} bookbinder-collapsed{{/if}}">
  <header class="bookbinder-toc-header">
    <h2>{{localize "BOOKBINDER.Toc.Title"}}</h2>
    <button type="button" class="bookbinder-toc-toggle" data-action="toggleToc" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
            aria-label="{{localize "BOOKBINDER.Toc.Toggle"}}" data-tooltip="{{localize "BOOKBINDER.Toc.Toggle"}}">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
  </header>
  <ol class="bookbinder-toc-list">
    {{#each entries}}
    <li><button type="button" data-action="goToPage" data-page-id="{{id}}" style="--bb-level:{{level}}">{{name}}</button></li>
    {{/each}}
  </ol>
</aside>
