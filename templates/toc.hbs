<aside class="bookbinder-toc{{#if collapsed}} bookbinder-collapsed{{/if}}">
  <header class="bookbinder-toc-header">
    <h2>{{localize "BOOKBINDER.Toc.Title"}}</h2>
    <button type="button" class="bookbinder-toc-toggle" data-action="toggleToc" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
            aria-label="{{localize "BOOKBINDER.Toc.Toggle"}}" data-tooltip="{{localize "BOOKBINDER.Toc.Toggle"}}">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
  </header>
  <ol class="bookbinder-toc-list">
    {{#each entries}}
    <li><a class="bookbinder-toc-entry" role="button" tabindex="0" data-action="goToPage" data-page-id="{{id}}" style="--bb-level:{{level}}"{{#if ../canSort}} draggable="true"{{/if}}>{{name}}</a></li>
    {{/each}}
  </ol>
  {{#if canCreate}}
  <footer class="bookbinder-toc-footer">
    <button type="button" class="bookbinder-toc-create" data-action="createPage"
            aria-label="{{localize "BOOKBINDER.Toc.AddPage"}}" data-tooltip="{{localize "BOOKBINDER.Toc.AddPage"}}">
      <i class="fa-solid fa-file-circle-plus fa-fw"></i><span>{{localize "BOOKBINDER.Toc.AddPage"}}</span>
    </button>
  </footer>
  {{/if}}
</aside>
